# k8s/deployment.yaml (nach automatischem Update durch Pipeline)
apiVersion: apps/v1
kind: Deployment
metadata:
  name: flask-webserver
spec:
  replicas: 3
  strategy:
    type: RollingUpdate          # Release-Strategie: Rolling Update
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
  template:
    spec:
      containers:
      - name: flask-app
        image: ghcr.io/team/flask-app:abc1234   # Neuer Tag, automatisch gesetzt
        ports:
        - containerPort: 5000
