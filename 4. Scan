# Ausschnitt: .github/workflows/pipeline.yml
- name: Security Scan (Bandit)
  run: |
    pip install bandit
    bandit -r app.py -ll --exit-zero

- name: Container Image Scan (Trivy)
  uses: aquasecurity/trivy-action@master
  with:
    image-ref: ghcr.io/team/flask-app:${{ github.sha }}
    severity: 'HIGH,CRITICAL'
    exit-code: '1'
